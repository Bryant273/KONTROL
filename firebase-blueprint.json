{
  "entities": {
    "Transaction": {
      "title": "Transaction Financière",
      "description": "Détails d'une transaction de vente ou d'achat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["VENTE", "ACHAT"] },
        "tiersId": { "type": "string" },
        "tiersNom": { "type": "string" },
        "montantTotal": { "type": "number" },
        "date": { "type": "number" },
        "statut": { "type": "string", "enum": ["PAYE", "ATTENTE", "ANNULE"] },
        "modePaiement": { "type": "string" },
        "reference": { "type": "string" },
        "devise": { "type": "string" },
        "tauxChange": { "type": "number" },
        "montantDevise": { "type": "number" },
        "articles": { "type": "array" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "type", "tiersId", "montantTotal", "statut"]
    },
    "UserProfile": {
      "title": "Profil Utilisateur",
      "description": "Données de profil d'un utilisateur",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMINISTRATEUR_ERP", "GESTIONNAIRE_ERP", "ADMINISTRATEUR_ENTREPRISE", "GESTIONNAIRE_ENTREPRISE", "UTILISATEUR", "ADMINISTRATEUR_KONTROL"] },
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "subscriptionStatus": { "type": "string" },
        "subscriptionEndDate": { "type": "number" }
      },
      "required": ["uid", "email", "role"]
    },
    "Company": {
      "title": "Entreprise",
      "description": "Informations sur une entreprise",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "sector": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notification système ou utilisateur",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "read": { "type": "boolean" },
        "timestamp": { "type": "number" }
      }
    },
    "PaymentRequest": {
      "title": "Demande de paiement",
      "description": "Demande de validation de paiement d'abonnement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "companyId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "reference": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "createdAt": { "type": "number" }
      }
    },
    "SubscriptionRequest": {
      "title": "Demande de validation d'abonnement Wave",
      "description": "Demande de validation de paiement de renouvellement d'abonnement via Wave",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "type": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "companyId", "amount", "transactionId", "status"]
    },
    "Payment": {
      "title": "Mouvement financier",
      "description": "Enregistrement d'un paiement (encaissement ou décaissement)",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["ENCAISSEMENT", "DECAISSEMENT"] },
        "date": { "type": "number" },
        "description": { "type": "string" }
      }
    },
    "Tier": {
      "title": "Tiers",
      "description": "Client ou fournisseur",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "type": { "type": "string", "enum": ["CLIENT", "FOURNISSEUR"] }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Profils utilisateurs"
    },
    "companies/{companyId}": {
      "schema": "Company",
      "description": "Données des entreprises"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notifications"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Transactions financières"
    },
    "produits/{produitId}": {
      "schema": "object",
      "description": "Produits et stocks"
    },
    "actions/{actionId}": {
      "schema": "object",
      "description": "Audit logs"
    },
    "payments/{paymentId}": {
      "schema": "Payment",
      "description": "Mouvements de trésorerie"
    },
    "payment_requests/{requestId}": {
      "schema": "PaymentRequest",
      "description": "Demandes d'abonnement"
    },
    "subscription_requests/{requestId}": {
      "schema": "SubscriptionRequest",
      "description": "Demandes de validation d'abonnement Wave"
    },
    "tiers/{tierId}": {
      "schema": "Tier",
      "description": "Carnet d'adresses tiers"
    },
    "charges/{chargeId}": {
      "schema": "object",
      "description": "Charges et dépenses"
    },
    "tickets/{ticketId}": {
      "schema": "object",
      "description": "Support tickets"
    },
    "app_versions/{versionId}": {
      "schema": "object",
      "description": "Versions de l'application"
    },
    "system_metrics/{metricId}": {
      "schema": "object",
      "description": "Métriques de performance système"
    },
    "system_stats/{statId}": {
      "schema": "object",
      "description": "Statistiques système globales"
    }
  }
}

{
  "entities": {
    "UserProfile": {
      "title": "Profil Utilisateur",
      "description": "Données de profil d'un utilisateur",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMINISTRATEUR_ERP", "GESTIONNAIRE_ERP", "ADMINISTRATEUR_ENTREPRISE", "GESTIONNAIRE_ENTREPRISE", "UTILISATEUR", "ADMINISTRATEUR_KONTROL"] },
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "role"]
    },
    "Company": {
      "title": "Entreprise",
      "description": "Informations sur une entreprise",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "sector": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notification système ou utilisateur",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "read": { "type": "boolean" },
        "timestamp": { "type": "number" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Profils utilisateurs"
    },
    "companies/{companyId}": {
      "schema": "Company",
      "description": "Données des entreprises"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notifications"
    },
    "transactions/{transactionId}": {
      "schema": "object",
      "description": "Transactions financières"
    },
    "produits/{produitId}": {
      "schema": "object",
      "description": "Produits et stocks"
    },
    "actions/{actionId}": {
      "schema": "object",
      "description": "Audit logs"
    }
  }
}

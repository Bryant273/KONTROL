rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. GLOBAL SAFETY NET: Default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. CORE HELPERS (Identity & Auth) ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      // In this environment, we sometimes use password auth without verification for test accounts
      return isSignedIn();
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserField(field, defaultValue) {
      return userExists() ? getUserData().get(field, defaultValue) : defaultValue;
    }

    function isKontrolAdmin() {
      return isSignedIn() && (
        (request.auth.token.get('email', '').lowerCase() in ['innov.korp@gmail.com', 'acherie812@gmail.com']) ||
        (userExists() && getUserData().get('role', '') in ['ADMINISTRATEUR_ERP', 'ADMINISTRATEUR_KONTROL', 'ADMIN', 'GESTIONNAIRE_ERP', 'GESTIONNAIRE_KONTROL'])
      );
    }

    function isCompanyAdmin(companyId) {
      return isEmailVerified() && (
        getUserField('role', '') == 'ADMINISTRATEUR_ENTREPRISE' && 
        getUserField('companyId', '') == companyId
      );
    }

    function isCompanyManager(companyId) {
      return isEmailVerified() && (
        (getUserField('role', '') == 'GESTIONNAIRE_ENTREPRISE' || getUserField('role', '') == 'ADMINISTRATEUR_ENTREPRISE') && 
        getUserField('companyId', '') == companyId
      );
    }

    function belongsToCompany(companyId) {
      return isEmailVerified() && getUserField('companyId', '') == companyId;
    }

    // --- 2. VALIDATION PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Strict schema check helper
    function hasRequiredKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().size() == keys.size();
    }

    // --- 3. ENTITY VALIDATORS (Blueprint Compliance) ---
    function isValidUser(data) {
      return hasRequiredKeys(data, ['uid', 'email', 'displayName', 'role', 'companyId', 'companyName', 'isProfileComplete', 'active', 'createdAt', 'subscriptionStatus', 'subscriptionEndDate']) &&
             data.email is string && data.email.size() < 256 &&
             data.role is string &&
             data.displayName is string && data.displayName.size() < 100 &&
             data.uid == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidTransaction(data) {
      return (data.montantTotal is number) && 
             data.date is number &&
             data.ownerId is string && 
             data.statut in ['PAYE', 'ATTENTE', 'ANNULE'] &&
             (data.devise == null || data.devise is string) &&
             (data.tauxChange == null || data.tauxChange is number) &&
             (data.montantDevise == null || data.montantDevise is number) &&
             data.createdAt is timestamp;
    }

    // --- 4. SECURE COLLECTIONS ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isKontrolAdmin());
      allow list: if isSignedIn() && (isKontrolAdmin() || resource.data.companyId == getUserField('companyId', ''));
      allow create: if isSignedIn() && request.auth.uid == userId; 
      allow update: if isEmailVerified() && (
        (request.auth.uid == userId && 
         incoming().diff(existing()).affectedKeys().hasOnly([
           'displayName', 'photoURL', 'phone', 'companyName', 'companyAbbreviation', 'companyLogo', 'logoUrl', 
           'country', 'city', 'address', 'currency', 'language', 'isProfileComplete', 'companyId', 'role', 'password', 'updatedAt', 'lastLogin',
           'subscriptionEndDate', 'subscriptionStatus'
         ]) && 
         (!(incoming().get('role', '') in ['ADMINISTRATEUR_ERP', 'ADMINISTRATEUR_KONTROL', 'ADMIN', 'GESTIONNAIRE_ERP', 'GESTIONNAIRE_KONTROL']) || isKontrolAdmin())
        ) ||
        isKontrolAdmin()
      );
    }

    match /companies/{companyId} {
      allow get: if isEmailVerified() && (belongsToCompany(companyId) || isKontrolAdmin());
      allow list: if isKontrolAdmin(); 
      allow create: if isKontrolAdmin() || isCompanyAdmin(companyId) || belongsToCompany(companyId);
      allow update: if isKontrolAdmin() || isCompanyAdmin(companyId) || isCompanyManager(companyId) || belongsToCompany(companyId);
      allow delete: if isKontrolAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isEmailVerified() && (resource.data.userId == request.auth.uid || belongsToCompany(resource.data.companyId) || isKontrolAdmin());
      allow list: if isEmailVerified() && (resource.data.userId == request.auth.uid || resource.data.companyId == getUserField('companyId', '') || isKontrolAdmin());
      allow update: if isEmailVerified() && (existing().userId == request.auth.uid || belongsToCompany(existing().companyId)) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isEmailVerified() && (existing().userId == request.auth.uid || isCompanyAdmin(existing().companyId) || isKontrolAdmin());
      allow create: if isEmailVerified(); 
    }

    match /transactions/{transactionId} {
      allow get, list: if isEmailVerified() && (isKontrolAdmin() || belongsToCompany(resource.data.ownerId));
      allow create: if isEmailVerified() && (belongsToCompany(incoming().ownerId) || isKontrolAdmin());
      allow update: if isEmailVerified() && (isKontrolAdmin() || isCompanyManager(existing().ownerId)); 
      allow delete: if isKontrolAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isEmailVerified() && (belongsToCompany(existing().ownerId) || isKontrolAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == getUserField('companyId', '') || isKontrolAdmin());
      allow create: if isEmailVerified() && (belongsToCompany(incoming().ownerId) || isCompanyManager(incoming().ownerId) || isKontrolAdmin()) && (incoming().createdAt is number || incoming().createdAt == request.time);
      allow update: if isEmailVerified() && (isKontrolAdmin() || isCompanyManager(existing().ownerId)) && 
                    incoming().ownerId == existing().ownerId;
    }

    match /tiers/{tierId} {
      allow get: if isEmailVerified() && (belongsToCompany(existing().ownerId) || isKontrolAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == getUserField('companyId', '') || isKontrolAdmin());
      allow create: if isEmailVerified() && (isCompanyManager(incoming().ownerId) || isKontrolAdmin());
      allow update: if isEmailVerified() && isCompanyManager(existing().ownerId) && incoming().ownerId == existing().ownerId;
      allow delete: if isEmailVerified() && (isCompanyAdmin(existing().ownerId) || isKontrolAdmin());
    }

    match /payment_requests/{requestId} {
      allow get, list: if isEmailVerified() && (isKontrolAdmin() || belongsToCompany(resource.data.companyId) || resource.data.userId == request.auth.uid);
      allow create: if isEmailVerified();
      allow update: if isKontrolAdmin() || isCompanyAdmin(existing().companyId);
    }

    match /subscription_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /charges/{chargeId} {
      allow get: if isEmailVerified() && (belongsToCompany(existing().ownerId) || isKontrolAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == getUserField('companyId', '') || isKontrolAdmin());
      allow create: if isEmailVerified() && (isCompanyManager(incoming().ownerId) || isKontrolAdmin());
      allow update: if isEmailVerified() && isCompanyManager(existing().ownerId) && incoming().ownerId == existing().ownerId;
      allow delete: if isEmailVerified() && (isCompanyAdmin(existing().ownerId) || isKontrolAdmin());
    }

    match /app_versions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isKontrolAdmin();
    }

    match /ai_proposals/{proposalId} {
      allow read: if isSignedIn();
      allow write: if isKontrolAdmin();
    }

    match /treasury_certificates/{certId} {
      allow read, list: if isEmailVerified() && (isKontrolAdmin() || resource.data.companyId == getUserField('companyId', ''));
      allow create: if isEmailVerified() && incoming().companyId == getUserField('companyId', '');
      allow update, delete: if isKontrolAdmin();
    }

    match /produits/{produitId} {
      allow get: if isEmailVerified() && (belongsToCompany(existing().ownerId) || isKontrolAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == getUserField('companyId', '') || isKontrolAdmin());
      allow create: if isEmailVerified() && (isCompanyManager(incoming().ownerId) || isKontrolAdmin()) && incoming().stock >= 0;
      allow update: if isEmailVerified() && isCompanyManager(existing().ownerId) && incoming().ownerId == existing().ownerId;
      allow delete: if isEmailVerified() && (isCompanyAdmin(existing().ownerId) || isKontrolAdmin());
    }

    match /actions/{actionId} {
      allow get: if isEmailVerified() && (isKontrolAdmin() || isCompanyAdmin(existing().companyId));
      allow list: if isEmailVerified() && (isKontrolAdmin() || resource.data.companyId == getUserField('companyId', ''));
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
    }

    match /tickets/{ticketId} {
      allow get: if isEmailVerified() && (isKontrolAdmin() || resource.data.userId == request.auth.uid || belongsToCompany(resource.data.companyId));
      allow list: if isEmailVerified() && (isKontrolAdmin() || resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email || belongsToCompany(resource.data.companyId));
      allow create: if isEmailVerified();
      allow update: if isEmailVerified() && (isKontrolAdmin() || existing().userId == request.auth.uid || isCompanyAdmin(existing().companyId));
    }

    match /stock_movements/{movementId} {
      allow get: if isEmailVerified() && (belongsToCompany(existing().ownerId) || isKontrolAdmin());
      allow list: if isEmailVerified() && (resource.data.ownerId == getUserField('companyId', '') || isKontrolAdmin());
      allow create: if isEmailVerified() && (isCompanyManager(incoming().ownerId) || isKontrolAdmin());
    }
    
    match /system/{document=**} {
      allow read: if isSignedIn();
      allow write: if isKontrolAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isEmailVerified() && (
        isKontrolAdmin() || 
        (resource.data != null && (request.auth.uid in resource.data.participants || resource.data.userId == request.auth.uid))
      );
      allow create: if isEmailVerified() && (
        isKontrolAdmin() || 
        (request.auth.uid in incoming().participants || incoming().userId == request.auth.uid)
      );
      allow update: if isEmailVerified() && (
        isKontrolAdmin() || 
        ( (request.auth.uid in resource.data.participants || resource.data.userId == request.auth.uid) &&
          incoming().participants == resource.data.participants &&
          incoming().userId == resource.data.userId
        )
      );
      allow delete: if isKontrolAdmin();
    }

    match /messages/{messageId} {
      allow read: if isEmailVerified() && (
        isKontrolAdmin() || 
        get(/databases/$(database)/documents/conversations/$(existing().conversationId)).data.participants.hasAny([request.auth.uid]) ||
        get(/databases/$(database)/documents/conversations/$(existing().conversationId)).data.userId == request.auth.uid
      );
      allow create: if isEmailVerified() && (
        isKontrolAdmin() || (
          (incoming().senderId == request.auth.uid || incoming().role == 'assistant') &&
          (
            get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.participants.hasAny([request.auth.uid]) ||
            get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.userId == request.auth.uid
          )
        )
      );
      allow delete: if isKontrolAdmin();
    }

    match /system_metrics/{metricId} {
      allow read, write: if isKontrolAdmin();
    }

    match /system_stats/{statId} {
      allow read, write: if isKontrolAdmin();
    }
  }
}

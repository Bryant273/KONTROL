rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. GLOBAL SAFETY NET: Default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. CORE HELPERS (Identity & Auth) ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      // In this environment, we sometimes use password auth without verification for test accounts
      return isSignedIn();
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserField(field, defaultValue) {
      return userExists() ? getUserData().get(field, defaultValue) : defaultValue;
    }

    function isCompanyAdmin(companyId) {
      return isEmailVerified() && (
        getUserField('role', '') == 'ADMINISTRATEUR_ENTREPRISE' && 
        getUserField('companyId', '') == companyId
      );
    }

    function isCompanyManager(companyId) {
      return isEmailVerified() && (
        (getUserField('role', '') == 'GESTIONNAIRE_ENTREPRISE' || getUserField('role', '') == 'ADMINISTRATEUR_ENTREPRISE') && 
        getUserField('companyId', '') == companyId
      );
    }

    function belongsToCompany(companyId) {
      return isEmailVerified() && getUserField('companyId', '') == companyId;
    }

    // --- 2. VALIDATION PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Strict schema check helper
    function hasRequiredKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().size() == keys.size();
    }

    // --- 3. ENTITY VALIDATORS (Blueprint Compliance) ---
    function isValidUser(data) {
      return hasRequiredKeys(data, ['uid', 'email', 'displayName', 'role', 'companyId', 'companyName', 'isProfileComplete', 'active', 'createdAt', 'subscriptionStatus', 'subscriptionEndDate']) &&
             data.email is string && data.email.size() < 256 &&
             data.role is string &&
             data.displayName is string && data.displayName.size() < 100 &&
             data.uid == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidTransaction(data) {
      return (data.montantTotal is number) && 
             data.date is number &&
             data.ownerId is string && 
             data.statut in ['PAYE', 'ATTENTE', 'ANNULE'] &&
             (data.devise == null || data.devise is string) &&
             (data.tauxChange == null || data.tauxChange is number) &&
             (data.montantDevise == null || data.montantDevise is number) &&
             data.createdAt is timestamp;
    }

    // --- 4. SECURE COLLECTIONS ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || belongsToCompany(getUserField('companyId', '')));
      allow list: if isSignedIn() && resource.data.companyId == getUserField('companyId', '');
      allow create: if isSignedIn() && request.auth.uid == userId; 
      allow update: if isEmailVerified() && request.auth.uid == userId;
    }

    match /companies/{companyId} {
      allow read, list: if isEmailVerified();
      allow create, update: if isEmailVerified();
      allow delete: if isEmailVerified() && isCompanyAdmin(companyId);
    }

    match /notifications/{notificationId} {
      allow get: if isEmailVerified() && (resource.data.userId == request.auth.uid || belongsToCompany(resource.data.companyId));
      allow list: if isEmailVerified();
      allow update: if isEmailVerified() && (existing().userId == request.auth.uid || belongsToCompany(existing().companyId)) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isEmailVerified() && (existing().userId == request.auth.uid || isCompanyAdmin(existing().companyId));
      allow create: if isEmailVerified(); 
    }

    match /transactions/{transactionId} {
      allow get, list: if isEmailVerified();
      allow create, update: if isEmailVerified(); 
      allow delete: if isEmailVerified();
    }

    match /payments/{paymentId} {
      allow get, list: if isEmailVerified();
      allow create, update: if isEmailVerified();
    }

    match /tiers/{tierId} {
      allow read, list: if isEmailVerified();
      allow create, update: if isEmailVerified();
      allow delete: if isEmailVerified() && isCompanyAdmin(existing().ownerId);
    }

    match /quotes/{quoteId} {
      allow read, list: if isEmailVerified();
      allow create, update, delete: if isEmailVerified();
    }

    match /payment_requests/{requestId} {
      allow get, list: if isEmailVerified() && (belongsToCompany(resource.data.companyId) || resource.data.userId == request.auth.uid);
      allow create: if isEmailVerified();
      allow update: if isEmailVerified() && isCompanyAdmin(existing().companyId);
    }

    match /subscription_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /charges/{chargeId} {
      allow read, list: if isEmailVerified();
      allow create, update: if isEmailVerified();
      allow delete: if isEmailVerified() && isCompanyAdmin(existing().ownerId);
    }

    match /app_versions/{versionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /ai_proposals/{proposalId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /treasury_certificates/{certId} {
      allow read, list: if isEmailVerified();
      allow create, update, delete: if isEmailVerified();
    }

    match /produits/{produitId} {
      allow read, list: if isEmailVerified();
      allow create, update: if isEmailVerified();
      allow delete: if isEmailVerified() && isCompanyAdmin(existing().ownerId);
    }

    match /actions/{actionId} {
      allow read, list, create: if isEmailVerified();
      allow update, delete: if isEmailVerified();
    }

    match /tickets/{ticketId} {
      allow get, list, create, update: if isEmailVerified();
      allow delete: if isEmailVerified();
    }

    match /stock_movements/{movementId} {
      allow get, list, create, update: if isEmailVerified();
      allow delete: if isEmailVerified();
    }
    
    match /system/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isEmailVerified() && (resource.data != null && (request.auth.uid in resource.data.participants || resource.data.userId == request.auth.uid));
      allow create: if isEmailVerified() && (request.auth.uid in incoming().participants || incoming().userId == request.auth.uid);
      allow update: if isEmailVerified() && (
        (request.auth.uid in resource.data.participants || resource.data.userId == request.auth.uid) &&
        incoming().participants == resource.data.participants &&
        incoming().userId == resource.data.userId
      );
      allow delete: if isEmailVerified();
    }

    match /messages/{messageId} {
      allow read: if isEmailVerified() && (
        get(/databases/$(database)/documents/conversations/$(existing().conversationId)).data.participants.hasAny([request.auth.uid]) ||
        get(/databases/$(database)/documents/conversations/$(existing().conversationId)).data.userId == request.auth.uid
      );
      allow create: if isEmailVerified() && (
        (incoming().senderId == request.auth.uid || incoming().role == 'assistant') &&
        (
          get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.participants.hasAny([request.auth.uid]) ||
          get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.userId == request.auth.uid
        )
      );
      allow delete: if isEmailVerified();
    }

    match /system_metrics/{metricId} {
      allow read, write: if false;
    }

    match /system_stats/{statId} {
      allow read, write: if false;
    }
  }
}

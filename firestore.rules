rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isKontrolAdmin() {
      return isSignedIn() && (
        getUserData().role == 'ADMINISTRATEUR_ERP' || 
        getUserData().role == 'ADMINISTRATEUR_KONTROL' ||
        request.auth.token.email in ['innov.korp@gmail.com', 'acherie812@gmail.com']
      );
    }

    function isCompanyAdmin(companyId) {
      return isSignedIn() && (
        getUserData().role == 'ADMINISTRATEUR_ENTREPRISE' && 
        getUserData().companyId == companyId
      );
    }

    function isCompanyManager(companyId) {
      return isSignedIn() && (
        (getUserData().role == 'GESTIONNAIRE_ENTREPRISE' || getUserData().role == 'ADMINISTRATEUR_ENTREPRISE') && 
        getUserData().companyId == companyId
      );
    }

    function belongsToCompany(companyId) {
      return isSignedIn() && getUserData().companyId == companyId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isKontrolAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isKontrolAdmin()) && (
        // Prevent role escalation by normal users
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId']) || isKontrolAdmin())
      );
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (belongsToCompany(companyId) || isKontrolAdmin());
      allow write: if isKontrolAdmin() || isCompanyAdmin(companyId);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (belongsToCompany(resource.data.companyId) || isKontrolAdmin());
      allow update: if isSignedIn() && belongsToCompany(resource.data.companyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && (isCompanyAdmin(resource.data.companyId) || isKontrolAdmin());
      allow create: if isKontrolAdmin(); // Only system/admins create notifications? 
      // Actually, some user actions might trigger notifications. For now, limit.
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (belongsToCompany(resource.data.ownerId) || isKontrolAdmin());
      allow write: if isCompanyManager(request.resource.data.ownerId) || isKontrolAdmin();
    }

    match /produits/{produitId} {
      allow read: if isSignedIn() && (belongsToCompany(resource.data.ownerId) || isKontrolAdmin());
      allow write: if isCompanyManager(request.resource.data.ownerId) || isKontrolAdmin();
    }

    match /actions/{actionId} {
      allow read: if isKontrolAdmin() || (isSignedIn() && isCompanyAdmin(resource.data.companyId));
      allow create: if isSignedIn(); // Users log their own actions
    }
  }
}

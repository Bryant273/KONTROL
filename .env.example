# KONTROL ERP - Environment Variables Example
# Duplicate this file to .env and fill in the values

# AI Brain (Required)
GEMINI_API_KEY=

# Wave Business Integration (Afrique de l'Ouest)
# Clé API fournie par le dashboard Wave Business (Mode Test ou Live)
WAVE_API_KEY=wave_ci_test_key_xxxx_yyyy_zzzz
# Identifiant Marchand (ex: M_ci_xxxxxx)
VITE_WAVE_MERCHANT_ID=M_ci_jlScZ6K4EoKg
# URL du Webhook pour les confirmations de paiement
WAVE_WEBHOOK_URL=https://votre-app-kontrol.com/api/wave/webhook

# GeniusPay Integration (Afrique de l'Ouest)
GENIUSPAY_API_KEY=pk_sandbox_test_key_geniuspay
GENIUSPAY_API_SECRET=sk_sandbox_test_secret_geniuspay
GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_test_secret_geniuspay
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
GENIUSPAY_SIGNATURE_HEADER=x-geniuspay-signature

